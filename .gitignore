# Credentials — never commit
.env

# Lab-specific config (machine-local — copy from lab_config.template.md and fill in)
lab_config.md

# Windows system files
desktop.ini
Thumbs.db

# Pipeline outputs
outputs/

# Cross-run knowledge bundle (OKF Phase 3) — local per-machine memory
knowledge/

# Slack session logs and temp prompt files
slack_sessions.log
session_logs/
_prompt_*.txt

# Persistent Playwright browser profile (contains Duo trusted-device cookies)
_browser_profile/

# daq source clone (installed as a git dependency, not committed)
_daq_src/

# Local instrument data — Leiden Cryogenics DR logs (large, lab-specific, not code)
# Point DR_DATA_PATH in .env at wherever these live on the running machine.
Data/

# Local documents and assets not required to run
figures/
*.pdf

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Claude Code project state (machine-local) — but agent definitions and
# skills are part of the pipeline and ARE committed (.claude/agents/,
# .claude/skills/). CLAUDE.md is a router that depends on the skills, so
# they MUST ship together or the lab machine gets a router with nothing to
# invoke.
.claude/*
!.claude/agents/
!.claude/skills/

# Local caches (page index, wiring diagram, org repos)
cache/

# Runtime artefacts dropped in the repo root by the pipeline
# (Slack image downloads, scratch plots) — not code.
slack_upload_*.jpg
slack_upload_*.png
output.png
